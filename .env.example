# ========================================
# TELEGRAM HEALTH BOT - FREE API CONFIGURATION
# All APIs below are 100% FREE to use!
# ========================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel

# ========================================
# FREE AI TEXT GENERATION
# ========================================

# OpenRouter.ai (FREE models available!)
# Sign up: https://openrouter.ai
# Free models: llama-3.2, gemma-2, mistral, qwen
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hugging Face Inference API (FREE!)
# Sign up: https://huggingface.co
HUGGINGFACE_API_KEY=your_huggingface_key_here

# Google Gemini Flash 2.0 (FREE with limits)
# Get key: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_key_here

# ========================================
# FREE IMAGE GENERATION
# ========================================

# Pollinations.ai (100% FREE, NO API KEY needed!)
# https://pollinations.ai
POLLINATIONS_ENABLED=true

# Hugging Face Stable Diffusion (FREE!)
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Replicate (FREE tier available)
# https://replicate.com
REPLICATE_API_TOKEN=your_replicate_token_here

# ========================================
# FREE VIDEO GENERATION (Optional)
# ========================================

# Replicate AnimateDiff (FREE tier)
REPLICATE_VIDEO_MODEL=lucataco/animate-diff

# ========================================
# LOGGING & ERROR HANDLING
# ========================================

LOG_LEVEL=INFO
DRAFT_DIR=drafts
ERROR_LOG_FILE=logs/errors.jsonl

# ========================================
# SCHEDULER SETTINGS
# ========================================

POST_INTERVAL_HOURS=4
MAX_POSTS_PER_DAY=6

# ========================================
# ANALYTICS
# ========================================

ANALYTICS_ENABLED=true
ANALYTICS_DB=data/analytics.db
